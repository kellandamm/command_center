{
  "name": "@homepage/server",
  "description": "Self-hosted personal command center dashboard (notes, calendar, daily briefing, pluggable panels).",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:notes-browser": "node scripts/build.mjs && tsx --test --test-concurrency=1 test/notes.browser.ts test/notes-productivity.browser.ts",
    "test:bookmarks-browser": "tsx --test test/bookmarks.browser.ts",
    "test:calendar-browser": "tsx --test --test-concurrency=1 test/calendar.browser.ts test/calendar-managed.browser.ts test/calendar-planning.browser.ts",
    "test:personal-dashboard-browser": "tsx --test test/personal-dashboard.browser.ts",
    "test:read-later-browser": "tsx --test test/read-later.browser.ts",
    "seed:dashboard-screenshot": "tsx scripts/seed-dashboard-screenshot.ts",
    "seed:ui-screenshots": "tsx scripts/seed-ui-screenshots.ts",
    "capture:ui-screenshots": "tsx scripts/capture-ui-screenshots.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "jose": "^6.2.12",
    "marked": "^17.0.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.55.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
