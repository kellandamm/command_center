{
  "name": "@homepage/server",
  "description": "Self-hosted AI Homepage: a headless-browser build host, scheduler, spend cap and edition archive around the same agent the extension runs.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@homepage/agent-core": "workspace:*",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.0",
    "jose": "^6.2.12",
    "playwright-core": "1.64.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
