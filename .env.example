# Copy to .env and adjust. LLM vars are optional (briefing disabled without them).

TZ=UTC
HOST_PORT=8088

# Cloudflare Access (recommended for command.gobison.io-style deploys)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-application-aud-tag

# Fallback auth (≥ 24 characters). Also: visit /?token=… once over HTTPS.
# ADMIN_TOKEN=
# Optional publish-only token for POST /api/ai-security/roundups (≥ 24 characters).
# AI_SECURITY_TOKEN=

# OpenAI-compatible chat completions (Command Code Provider API)
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=
LLM_MODEL=

# Todoist REST API (optional — panel shows disabled message without it)
# TODOIST_API_TOKEN=

# Optional: Docker Engine API socket for Server health container list (see SELFHOST.md; not in default compose).
# DOCKER_SOCKET=/var/run/docker.sock

# Optional: GitHub activity panel (higher API rate limits with a token)
# GITHUB_TOKEN=
# GITHUB_USERNAME=kellandamm

# Recallio memory search (optional panel)
# RECALLIO_URL=https://recall.gobison.io
# When Recallio is behind Cloudflare Access, create a service token and set:
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Weather panel (Open-Meteo, no API key). Defaults to Chicago if unset.
# WEATHER_LAT=41.8781
# WEATHER_LON=-87.6298

# Calendar panel: comma-separated https iCal feed URLs (optional)
# ICS_URLS=https://calendar.google.com/calendar/ical/example/public/basic.ics

# Local dev only
# ALLOW_INSECURE_NO_AUTH=1
# DATA_DIR=./data
