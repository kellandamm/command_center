# Copy to .env and adjust. LLM vars enable summaries, Notes questions, and keyword digests.

TZ=UTC
HOST_PORT=8088

# Cloudflare Access (recommended for command.gobison.io-style deploys)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-application-aud-tag

# Settings > Service connections: owner emails must match verified Access users.
# Machine tokens and ADMIN_TOKEN cannot manage the credential vault.
# OWNER_EMAILS=you@example.com
# Generate 32 random bytes, encode as 64 hex characters; keep a separate secure backup.
# Never change this key without re-encrypting or removing the existing vault first.
# CONNECTIONS_MASTER_KEY=

# Google Calendar OAuth (optional). Register this exact callback URL in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/google-calendar/callback

# Fallback auth (≥ 24 characters). Also: visit /?token=… once over HTTPS.
# ADMIN_TOKEN=

# OpenAI-compatible chat completions (Command Code Provider API)
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=
LLM_MODEL=

# Keyword briefings: Brave web search, summarized through the LLM above.
# BRAVE_SEARCH_API_KEY=

# Todoist REST API (optional — panel shows disabled message without it)
# TODOIST_API_TOKEN=

# Optional: Docker Engine API socket for Server health container list (see SELFHOST.md; not in default compose).
# DOCKER_SOCKET=/var/run/docker.sock

# Optional: GitHub activity panel (higher API rate limits with a token)
# GITHUB_TOKEN=
# GITHUB_USERNAME=kellandamm

# Recallio memory search (optional panel)
# RECALLIO_URL=https://recall.gobison.io
# When Recallio is behind Cloudflare Access, create a service token and set:
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Weather panel (Open-Meteo, no API key). Defaults to Chicago if unset.
# WEATHER_LAT=41.8781
# WEATHER_LON=-87.6298

# Calendar panel: comma-separated https iCal feed URLs (optional)
# ICS_URLS=https://calendar.google.com/calendar/ical/example/public/basic.ics

# MCP integrations (optional — /mcp Streamable HTTP + Power Automate webhook)
# REQUIRED (non-empty) for /mcp and the webhook — map MCP client id → service token id (JWT common_name):
# MCP_CF_CLIENT_MAP={"copilot":"<service-token-client-id>","power-automate":"<id>"}
# Integrations also require CF_ACCESS_TEAM_DOMAIN + CF_ACCESS_AUD (JWT verified on Cf-Access-Jwt-Assertion).
# Per-client bearer tokens (JSON). Each value ≥ 24 characters (pair with the same client id above).
# MCP_APP_TOKENS={"copilot":"xxxxxxxxxxxxxxxxxxxxxxxx","power-automate":"yyyyyyyyyyyyyyyyyyyyyyyyyyyy"}
# WEBHOOK_SECRET=  # ≥ 24 chars; send X-Webhook-Secret through Access (Cf-Access-Jwt-Assertion required)
# BOOKMARKS_IMPORT_SECRET=  # ≥ 24 chars; X bookmarks POST /api/bookmarks/import with X-Bookmarks-Secret + Cf-Access-Jwt-Assertion
# HOBIE_POLL_TOKEN=  # optional; Hobie may also use ADMIN_TOKEN or an MCP app token
# MCP_MAX_HOBIE_PENDING=20

# Local dev only
# ALLOW_INSECURE_NO_AUTH=1
# DATA_DIR=./data
